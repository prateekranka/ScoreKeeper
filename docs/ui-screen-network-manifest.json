        { "screen": "PS", "transition": "Start" },
        { "screen": "P3", "transition": "Start" },
        { "screen": "P4", "transition": "10th round" },
        { "screen": "PC", "transition": "End Game" },
        { "screen": "GO", "transition": "" }
      ]
    },
    {
