        { "screen": "EA", "transition": "Confirm" },
        { "screen": "GO", "transition": "" }
      ]
    },
    {
      "title": "C. New What's for Dinner Game",
      "subtitle": "Dinner skips GameConfigView and creates the scoring session directly from PlayerSetupView.",
      "steps": [
        { "screen": "H0", "transition": "New Game" },
        { "screen": "GP", "transition": "Dinner" },
        { "screen": "WT", "transition": "Start" },
        { "screen": "WS", "transition": "End Game" },
        { "screen": "EA", "transition": "Confirm" },
        { "screen": "GO", "transition": "" }
      ]
    },
    {
