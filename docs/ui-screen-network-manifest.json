    {
      "title": "F. Resume, Replay, and Roster Loops",
      "subtitle": "Hub flows that return users to active scoring or setup without a fresh game-type decision.",
      "rows": [
        {
          "label": "Resume Active",
          "steps": [
            { "screen": "H1", "transition": "Resume" },
